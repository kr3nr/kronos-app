{
  "expo": {
    "name": "kronos",
    "slug": "kronos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/VenKash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.madebykr3n.kronos",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "2541b94d-47ec-4314-89a3-5bd862b18edd"
      }
    },
    "owner": "madebykr3n",
    "android": {
      "package": "com.madebykr3n.kronos"
    }
  }
}
