{
  "expo": {
    "name": "kronos",
    "slug": "kronos",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.madebykr3n.kronos",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir a Kronos usar Face ID para desbloquear la aplicación."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "2541b94d-47ec-4314-89a3-5bd862b18edd"
      }
    },
    "owner": "madebykr3n",
    "android": {
      "package": "com.madebykr3n.kronos",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "runtimeVersion": "1.0.1",
    "updates": {
      "url": "https://u.expo.dev/2541b94d-47ec-4314-89a3-5bd862b18edd"
    }
  }
}
