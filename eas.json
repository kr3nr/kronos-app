{
  "cli": {
    "version": ">= 24.12.1",
    "appVersionSource": "remote",
    "nodeMethod": "npm",
    "npmArgs": ["--legacy-peer-deps"]
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
